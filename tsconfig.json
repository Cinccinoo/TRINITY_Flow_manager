{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "TRINITY_SYSTEMFLOW_MGT_SVELTE/**/*.ts", "TRINITY_SYSTEMFLOW_MGT_SVELTE/**/*.svelte"]
}
